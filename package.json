    "@types/node": "^20.11.0",
    "esbuild": "0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.70.0"
  }
}
